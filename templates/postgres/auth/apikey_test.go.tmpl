package auth

import (
	"context"
	"fmt"
	"net/http"
	"strings"
	"testing"
	"time"
)

func TestAPIKeyLifecycle(t *testing.T) {
	e := newTestEnv(t)
	owner := e.as(e.register("keys@x.io"))

	var created createdKey
	owner.POST("/auth/api-keys").JSON(map[string]any{"name": "ci", "scopes": []string{"orders:read"}}).Do().
		ExpectStatus(http.StatusCreated).Decode(&created)
	if !strings.HasPrefix(created.Key, "sk_test_"+created.Prefix+"_") || created.Scopes[0] != "orders:read" {
		t.Fatalf("%+v", created)
	}
	// Listing never returns the secret.
	list := owner.GET("/auth/api-keys").Do().ExpectStatus(http.StatusOK)
	if strings.Contains(string(list.Body()), created.Key) || strings.Contains(string(list.Body()), `"key"`) {
		t.Errorf("secret listed: %s", list.Body())
	}

	// The key authenticates, but cannot manage keys.
	e.c.POST("/auth/logout").Header("X-API-Key", created.Key).Do().ExpectStatus(http.StatusNoContent)
	e.c.GET("/auth/api-keys").Bearer(created.Key).Do().ExpectProblem(http.StatusForbidden, "forbidden")
	e.c.POST("/auth/logout").Header("X-API-Key", created.Key[:len(created.Key)-2]+"zz").Do().
		ExpectProblem(http.StatusUnauthorized, "invalid_credentials")

	// Another user cannot revoke it (no IDOR).
	other := e.as(e.register("other@x.io"))
	other.DELETE(fmt.Sprintf("/auth/api-keys/%v", created.ID)).Do().ExpectProblem(http.StatusNotFound, "not_found")

	// Checklist: revoked keys are rejected.
	owner.DELETE(fmt.Sprintf("/auth/api-keys/%v", created.ID)).Do().ExpectStatus(http.StatusNoContent)
	e.c.POST("/auth/logout").Header("X-API-Key", created.Key).Do().ExpectProblem(http.StatusUnauthorized, "invalid_credentials")
}

// Checklist: expired keys are rejected.
func TestAPIKeyExpiry(t *testing.T) {
	e := newTestEnv(t)
	owner := e.as(e.register("exp@x.io"))
	owner.POST("/auth/api-keys").JSON(map[string]any{"name": "x", "expires_at": time.Now().Add(-time.Hour)}).Do().
		ExpectFieldError("expires_at", "future")

	var created createdKey
	owner.POST("/auth/api-keys").JSON(map[string]any{"name": "x", "expires_at": time.Now().Add(time.Hour)}).Do().
		ExpectStatus(http.StatusCreated).Decode(&created)
	e.c.POST("/auth/logout").Header("X-API-Key", created.Key).Do().ExpectStatus(http.StatusNoContent)
	_, err := e.h.svc.pool.Exec(context.Background(), "UPDATE api_keys SET expires_at = now() - interval '1 minute' WHERE prefix = $1", created.Prefix)
	if err != nil {
		t.Fatal(err)
	}
	e.c.POST("/auth/logout").Header("X-API-Key", created.Key).Do().ExpectProblem(http.StatusUnauthorized, "invalid_credentials")
}
