package auth

import (
	"context"
	"fmt"
	"strconv"
	"time"

	"github.com/google/uuid"
	"{{.Module}}/db/sqlc"
	semiiauth "{{.Semii}}/auth"
	"{{.Semii}}/db/pgxdb"
)

func apiKeyFromRow(r sqlc.ApiKey) APIKey {
	scopes := r.Scopes
	if scopes == nil {
		scopes = []string{}
	}
	return APIKey{ID: r.ID, Name: r.Name, Prefix: r.Prefix, Scopes: scopes,
		ExpiresAt: r.ExpiresAt, LastUsedAt: r.LastUsedAt, CreatedAt: r.CreatedAt}
}

func (s *store) CreateAPIKey(ctx context.Context, r apiKeyRow) (APIKey, error) {
	row, err := s.queries(ctx).CreateAPIKey(ctx, sqlc.CreateAPIKeyParams{
{{- if .UUID}}
		ID: newID(),
{{- end}}
		UserID: r.UserID, Name: r.Name, Prefix: r.Prefix, SecretHash: r.SecretHash,
		Scopes: r.Scopes, ExpiresAt: r.ExpiresAt, CreatedAt: r.CreatedAt,
	})
	if err != nil {
		return APIKey{}, pgxdb.MapError(err)
	}
	return apiKeyFromRow(row), nil
}

// FindAPIKey implements semiiauth.APIKeyStore.
func (s *store) FindAPIKey(ctx context.Context, prefix string) (semiiauth.APIKey, error) {
	row, err := s.queries(ctx).FindAPIKeyByPrefix(ctx, prefix)
	if err != nil {
		return semiiauth.APIKey{}, pgxdb.MapError(err)
	}
	return semiiauth.APIKey{
		ID: fmt.Sprint(row.ID), OwnerID: IDString(row.UserID), Scopes: row.Scopes, SecretHash: row.SecretHash,
		ExpiresAt: row.ExpiresAt, RevokedAt: row.RevokedAt, LastUsedAt: row.LastUsedAt,
	}, nil
}

// TouchAPIKey implements semiiauth.APIKeyStore.
func (s *store) TouchAPIKey(ctx context.Context, id string, at time.Time) error {
{{- if .UUID}}
	keyID, err := uuid.Parse(id)
{{- else}}
	keyID, err := strconv.ParseInt(id, 10, 64)
{{- end}}
	if err != nil {
		return err
	}
	return s.queries(ctx).TouchAPIKey(ctx, sqlc.TouchAPIKeyParams{ID: keyID, Now: at})
}

func (s *store) ListAPIKeys(ctx context.Context, owner {{.IDGo}}) ([]APIKey, error) {
	rows, err := s.queries(ctx).ListAPIKeys(ctx, owner)
	if err != nil {
		return nil, err
	}
	keys := make([]APIKey, len(rows))
	for i, row := range rows {
		keys[i] = apiKeyFromRow(row)
	}
	return keys, nil
}

// RevokeAPIKey revokes id if owner owns it, returning how many keys changed.
func (s *store) RevokeAPIKey(ctx context.Context, id, owner {{.IDGo}}, at time.Time) (int64, error) {
	return s.queries(ctx).RevokeAPIKey(ctx, sqlc.RevokeAPIKeyParams{ID: id, UserID: owner, Now: at})
}

// expireAPIKey sets a key's expiry (tests).
func (s *store) expireAPIKey(ctx context.Context, prefix string, at time.Time) error {
	return s.queries(ctx).ExpireAPIKey(ctx, sqlc.ExpireAPIKeyParams{Prefix: prefix, At: at})
}
