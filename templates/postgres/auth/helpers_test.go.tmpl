	"{{.Semii}}/web"
)

func TestMain(m *testing.M) { testkit.Main(m) }

const strongPassword = "correct-horse-battery-staple"

// lockedBuffer collects logs written by background goroutines.
type lockedBuffer struct {
	mu  sync.Mutex
	buf bytes.Buffer
}

func (b *lockedBuffer) Write(p []byte) (int, error) {
	b.mu.Lock()
	defer b.mu.Unlock()
	return b.buf.Write(p)
}

func (b *lockedBuffer) String() string {
	b.mu.Lock()
	defer b.mu.Unlock()
	return b.buf.String()
}

// testEnv is the auth stack on a fresh database, with mail captured.
type testEnv struct {
	t       *testing.T
	handler http.Handler
	h    *Handler
	c    *testkit.Client
	q    *sqlc.Queries
	mail *semiiauth.MemorySender
	logs *lockedBuffer
	cfg  config.Config
}

func newTestEnv(t *testing.T, mutate ...func(*config.Config)) *testEnv {
	t.Helper()
	pool := testkit.Postgres(t, testkit.WithMigrations(appdb.Migrations()))
	vars := map[string]string{
		"DATABASE_URL":    "postgres://unused",
		"AUTH_STRATEGIES": "{{join .Strategies ","}}",
		"AUTH_JWT_SECRET": "test-secret-test-secret-test-secret-0123",
		"AUTH_APP_URL":    "https://app.test",
	}
	cfg, err := config.Load(semiiconfig.WithEnv("test"), semiiconfig.WithDir(t.TempDir()),
		semiiconfig.WithLookup(func(k string) (string, bool) { v, ok := vars[k]; return v, ok }))
	if err != nil {
		t.Fatal(err)
	}
	for _, m := range mutate {
		m(&cfg)
	}
	logs := &lockedBuffer{}
	log := slog.New(slog.NewJSONHandler(logs, nil))
	h, authN, err := Wire(cfg, pool, log)
	if err != nil {
		t.Fatal(err)
	}
	mail := &semiiauth.MemorySender{}
	h.svc.sender = mail
	r := web.NewRouter(web.Options{Logger: log, Env: cfg.Env})
	Register(r, h)
	if err := r.Verify(); err != nil {
		t.Fatal(err)
	}
	handler := web.Chain(r, web.RequestID(), web.RealIP(nil), web.Logger(log), semiiauth.Middleware(authN...))
	t.Cleanup(h.svc.Wait)
	return &testEnv{t: t, handler: handler, h: h, c: testkit.NewClient(t, handler), q: sqlc.New(pool), mail: mail, logs: logs, cfg: cfg}
}

// register creates an account through the API and waits for its mail.
func (e *testEnv) register(email string) User {
	e.t.Helper()
	e.c.POST("/auth/register").JSON(map[string]string{"email": email, "password": strongPassword}).Do().ExpectStatus(201)
	e.h.svc.Wait()
	row, err := e.q.GetUserByEmail(context.Background(), strings.ToLower(email))
	if err != nil {
		e.t.Fatal(err)
	}
	return UserFromRow(row)
}

// as returns a client acting as u without real credentials.
func (e *testEnv) as(u User) *testkit.Client {
	return e.c.As(&semiiauth.Principal{ID: IDString(u.ID), Kind: semiiauth.KindUser, Roles: u.Roles})
}

// mailedToken returns the token of the last mail of kind sent to email.
func (e *testEnv) mailedToken(kind, email string) string {
	e.t.Helper()
	e.h.svc.Wait()
	m, ok := e.mail.Last(kind, email)
	if !ok {
		e.t.Fatalf("no %s mail to %s (sent: %+v)", kind, email, e.mail.Sent())
	}
	u, err := url.Parse(m.Link)
	if err != nil || !strings.HasPrefix(m.Link, "https://app.test/") {
		e.t.Fatalf("bad link %q", m.Link)
	}
	return u.Query().Get("token")
}

func (e *testEnv) login(email, password string, mode string) *testkit.Response {
	body := map[string]string{"email": email, "password": password}
	if mode != "" {
		body["mode"] = mode
	}
	return e.c.POST("/auth/login").Header("Sec-Fetch-Site", "same-origin").JSON(body).Do()
}
