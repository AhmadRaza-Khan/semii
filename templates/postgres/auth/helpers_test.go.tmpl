package auth

import (
	"bytes"
	"context"
	"log/slog"
	"net/http"
	"net/url"
	"strings"
	"sync"
	"testing"

	appdb "{{.Module}}/db"
	"{{.Module}}/db/sqlc"
	"{{.Module}}/internal/config"
	semiiauth "{{.Semii}}/auth"
	semiiconfig "{{.Semii}}/config"
