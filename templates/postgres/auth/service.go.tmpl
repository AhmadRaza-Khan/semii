// Token lifetimes and limits.
const (
	resetTTL       = time.Hour
	verifyTTL      = 24 * time.Hour
	attemptsPerMin = 20 // per client IP, for login, register and forgot
	mailTimeout    = 30 * time.Second
)

// Service implements the account flows.
type Service struct {
	cfg     config.Config
	pool    *pgxpool.Pool
	q       *sqlc.Queries
	hasher  *password.Hasher
	sender  semiiauth.Sender
	limiter *semiiauth.Limiter
	log     *slog.Logger
	active  []strategy // enabled strategies, in AUTH_STRATEGIES order
	wg      sync.WaitGroup
}

// newService always returns a usable Service; a configuration error (such
// as no SMTP_HOST in production) is returned alongside for boot to report.
func newService(cfg config.Config, pool *pgxpool.Pool, log *slog.Logger) (*Service, error) {
	hasher, err := password.NewHasher(password.DefaultParams, 4)
	if err != nil {
		panic(err) // DefaultParams are valid
	}
	sender, err := newSender(cfg, log)
	if err != nil {
		sender = semiiauth.LogSender{Log: log}
	}
	return &Service{
		cfg: cfg, pool: pool, q: sqlc.New(pool), hasher: hasher, sender: sender,
		limiter: semiiauth.NewLimiter(attemptsPerMin, time.Minute), log: log,
	}, err
}

// enabled reports whether the named strategy is active.
func (s *Service) enabled(name string) bool {
	return slices.ContainsFunc(s.active, func(st strategy) bool { return st.name() == name })
}

// Wait blocks until background mail jobs finish (tests, shutdown).
func (s *Service) Wait() { s.wg.Wait() }

// background runs fn after the response, so mail delivery neither delays
// nor (through timing) reveals anything about the account.
func (s *Service) background(what string, fn func(ctx context.Context) error) {
	s.wg.Add(1)
	go func() {
		defer s.wg.Done()
		ctx, cancel := context.WithTimeout(context.Background(), mailTimeout)
		defer cancel()
		if err := fn(ctx); err != nil {
			s.log.Error("auth background job failed", "job", what, "error", err)
		}
	}()
}

// limit applies the per-IP attempt limit for action.
func (s *Service) limit(r *http.Request, action string) error {
	if ok, retry := s.limiter.Allow(action + ":" + web.ClientIP(r).String()); !ok {
		return web.TooManyRequests(retry)
	}
	return nil
}

func normalizeEmail(email string) string { return strings.ToLower(strings.TrimSpace(email)) }

func (s *Service) checkPassword(pw string) error {
	if err := password.Check(pw, s.cfg.Auth.CheckCommonPasswords); err != nil {
		return web.Unprocessable("password rejected", web.FieldError{Field: "password", Code: "password", Message: err.Error()})
	}
	return nil
}

// Register creates an account and mails a verification link. An existing
// email gets the same response and no mail, so registration does not
// reveal which emails have accounts.
func (s *Service) Register(ctx context.Context, email, pw string) error {
	if err := s.checkPassword(pw); err != nil {
		return err
	}
	hash, err := s.hasher.Hash(ctx, pw)
	if err != nil {
		return err
	}
	t := now()
	row, err := s.q.CreateUser(ctx, sqlc.CreateUserParams{
{{- if .UUID}}
		ID: newID(),
{{- end}}
		Email: normalizeEmail(email), PasswordHash: hash, Roles: []string{}, CreatedAt: t, UpdatedAt: t,
	})
	if errors.Is(err, pgx.ErrNoRows) {
		return nil // already registered
	}
	if err != nil {
		return fmt.Errorf("auth register: %w", pgxdb.MapError(err))
	}
	s.background("verification mail", func(ctx context.Context) error {
		return s.sendVerification(ctx, row.ID, row.Email)
	})
	return nil
}

// Authenticate checks credentials with timing parity for unknown emails,
// per-account lockout and transparent rehashing.
func (s *Service) Authenticate(ctx context.Context, email, pw string) (User, error) {
	row, err := s.q.GetUserByEmail(ctx, normalizeEmail(email))
	if errors.Is(err, pgx.ErrNoRows) {
		s.hasher.VerifyDummy(ctx, pw)
		return User{}, semiiauth.ErrInvalidCredentials
	}
	if err != nil {
		return User{}, fmt.Errorf("auth login: %w", pgxdb.MapError(err))
	}
	u := UserFromRow(row)
	ok, rehash, err := s.hasher.Verify(ctx, pw, u.passwordHash)
	if err != nil {
		return User{}, fmt.Errorf("auth login: %w", err)
	}
	t := now()
	if u.lockedUntil != nil && t.Before(*u.lockedUntil) {
		return User{}, semiiauth.ErrInvalidCredentials // same answer while locked
	}
	if !ok {
		n, err := s.q.RecordLoginFailure(ctx, sqlc.RecordLoginFailureParams{ID: u.ID, Now: t})
		if err != nil {
			return User{}, fmt.Errorf("auth login: %w", err)
		}
		if d := semiiauth.LockoutBackoff(int(n)); d > 0 {
			if err := s.q.LockUser(ctx, sqlc.LockUserParams{ID: u.ID, Until: t.Add(d)}); err != nil {
				return User{}, fmt.Errorf("auth login: %w", err)
			}
		}
		return User{}, semiiauth.ErrInvalidCredentials
	}
	if u.failedLogins > 0 || u.lockedUntil != nil {
		if err := s.q.RecordLoginSuccess(ctx, u.ID); err != nil {
			return User{}, fmt.Errorf("auth login: %w", err)
		}
	}
	if rehash {
		if hash, err := s.hasher.Hash(ctx, pw); err == nil {
			_ = s.q.UpdatePasswordHash(ctx, sqlc.UpdatePasswordHashParams{ID: u.ID, PasswordHash: hash, Now: t})
		}
	}
	if s.cfg.Auth.RequireVerifiedEmail && !u.EmailVerified {
		return User{}, errUnverified
	}
	return u, nil
}

// Forgot mails a reset link when the email has an account. It always
// succeeds immediately; the lookup and mail happen in the background.
func (s *Service) Forgot(email string) {
	email = normalizeEmail(email)
	s.background("reset mail", func(ctx context.Context) error {
		row, err := s.q.GetUserByEmail(ctx, email)
		if errors.Is(err, pgx.ErrNoRows) {
			return nil
		}
		if err != nil {
			return err
		}
		tok, err := s.newAuthToken(ctx, s.q, row.ID, "reset", resetTTL)
		if err != nil {
			return err
		}
		return s.sender.SendPasswordReset(ctx, row.Email, s.link("/reset-password", tok))
	})
}

// ResetPassword consumes a reset token, sets the password and revokes
// every session and refresh token of the user, in one transaction.
func (s *Service) ResetPassword(r *http.Request, token, pw string) error {
	if err := s.checkPassword(pw); err != nil {
		return err
	}
	hash, err := s.hasher.Hash(r.Context(), pw)
	if err != nil {
		return err
	}
	return pgxdb.WithTx(r.Context(), s.pool, func(tx pgx.Tx) error {
		q := s.q.WithTx(tx)
		t := now()
		id, err := q.ConsumeAuthToken(r.Context(), sqlc.ConsumeAuthTokenParams{
			TokenHash: semiiauth.HashToken(token), Kind: "reset", Now: t,
		})
		if errors.Is(err, pgx.ErrNoRows) {
			return errInvalidToken
		}
		if err != nil {
			return err
		}
		if err := q.UpdatePasswordHash(r.Context(), sqlc.UpdatePasswordHashParams{ID: id, PasswordHash: hash, Now: t}); err != nil {
			return err
		}
		for _, st := range s.active {
			if err := st.revokeAll(r, q, id); err != nil {
				return err
			}
		}
		return nil
	})
}

// VerifyEmail consumes a verification token.
func (s *Service) VerifyEmail(ctx context.Context, token string) error {
	t := now()
	id, err := s.q.ConsumeAuthToken(ctx, sqlc.ConsumeAuthTokenParams{
		TokenHash: semiiauth.HashToken(token), Kind: "verify", Now: t,
	})
	if errors.Is(err, pgx.ErrNoRows) {
		return errInvalidToken
	}
	if err != nil {
		return err
	}
	return s.q.MarkEmailVerified(ctx, sqlc.MarkEmailVerifiedParams{ID: id, Now: t})
}

// ResendVerification mails a new verification link to an unverified user.
func (s *Service) ResendVerification(ctx context.Context, id {{.IDGo}}) error {
	u, err := s.User(ctx, id)
	if err != nil || u.EmailVerified {
		return err
	}
	s.background("verification mail", func(ctx context.Context) error {
		return s.sendVerification(ctx, u.ID, u.Email)
	})
	return nil
}

// User loads an account.
func (s *Service) User(ctx context.Context, id {{.IDGo}}) (User, error) {
	row, err := s.q.GetUser(ctx, id)
	if err != nil {
		return User{}, fmt.Errorf("auth user: %w", pgxdb.MapError(err))
	}
	return UserFromRow(row), nil
}

func (s *Service) sendVerification(ctx context.Context, id {{.IDGo}}, email string) error {
	tok, err := s.newAuthToken(ctx, s.q, id, "verify", verifyTTL)
	if err != nil {
		return err
	}
	return s.sender.SendVerification(ctx, email, s.link("/verify-email", tok))
}

// newAuthToken stores the hash of a new one-time token and returns the raw
// token for the link.
func (s *Service) newAuthToken(ctx context.Context, q *sqlc.Queries, id {{.IDGo}}, kind string, ttl time.Duration) (string, error) {
	tok, err := semiiauth.NewToken()
	if err != nil {
		return "", err
	}
	t := now()
	err = q.CreateAuthToken(ctx, sqlc.CreateAuthTokenParams{
		TokenHash: tok.Hash, UserID: id, Kind: kind, ExpiresAt: t.Add(ttl), CreatedAt: t,
	})
	return tok.Raw, err
}

// link builds a frontend URL from AUTH_APP_URL carrying token.
func (s *Service) link(path, token string) string {
	return strings.TrimRight(s.cfg.Auth.AppURL, "/") + path + "?token=" + url.QueryEscape(token)
}
