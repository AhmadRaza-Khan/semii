-- name: CreateAPIKey :one
INSERT INTO api_keys ({{if .UUID}}id, {{end}}user_id, name, prefix, secret_hash, scopes, expires_at, created_at)
VALUES ({{if .UUID}}$1, $2, $3, $4, $5, $6, $7, $8{{else}}$1, $2, $3, $4, $5, $6, $7{{end}})
RETURNING *;

-- name: FindAPIKeyByPrefix :one
SELECT * FROM api_keys WHERE prefix = $1;

-- name: TouchAPIKey :exec
UPDATE api_keys SET last_used_at = sqlc.arg('now')::timestamptz WHERE id = sqlc.arg('id');

-- name: ListAPIKeys :many
SELECT * FROM api_keys WHERE user_id = $1 AND revoked_at IS NULL ORDER BY created_at DESC;

-- name: RevokeAPIKey :execrows
-- Scoped to the owner, so one user cannot revoke another's key.
UPDATE api_keys SET revoked_at = sqlc.arg('now')::timestamptz
WHERE id = sqlc.arg('id') AND user_id = sqlc.arg('user_id') AND revoked_at IS NULL;
