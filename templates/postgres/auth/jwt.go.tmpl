package auth

import (
	"errors"
	"fmt"
	"net/http"

	"github.com/google/uuid"
	"github.com/jackc/pgx/v5"
	"{{.Module}}/db/sqlc"
	semiiauth "{{.Semii}}/auth"
	"{{.Semii}}/db/pgxdb"
	"{{.Semii}}/web"
)

// jwtStrategy signs users in with a short-lived access token (JWT) and a
// rotating, single-use refresh token.
type jwtStrategy struct {
	svc *Service
	jwt *semiiauth.JWT
	err error // configuration error, reported by Validate at boot
}

func newJWTStrategy(svc *Service) *jwtStrategy {
	j, err := semiiauth.NewJWT(svc.cfg.Auth)
	return &jwtStrategy{svc: svc, jwt: j, err: err}
}

func (s *jwtStrategy) name() string { return "jwt" }

func (s *jwtStrategy) authenticator() semiiauth.Authenticator {
	if s.jwt == nil {
		return semiiauth.AuthenticatorFunc(func(*http.Request) (*semiiauth.Principal, error) { return nil, s.err })
	}
	return s.jwt
}

func (s *jwtStrategy) routes(g *web.Router) {
	g.HandleFunc("POST /refresh", s.refresh).Public()
}

type tokenPair struct {
	AccessToken  string `json:"access_token"`
	RefreshToken string `json:"refresh_token"`
	TokenType    string `json:"token_type"`
	ExpiresIn    int    `json:"expires_in"` // seconds
}

func (s *jwtStrategy) login(w http.ResponseWriter, r *http.Request, u User) error {
	pair, err := s.issue(r, s.svc.q, u, uuid.Must(uuid.NewV7()))
	if err != nil {
		return err
	}
	return web.JSON(w, http.StatusOK, pair)
}

// issue signs an access token and stores a new refresh token in family.
func (s *jwtStrategy) issue(r *http.Request, q *sqlc.Queries, u User, family uuid.UUID) (tokenPair, error) {
	if s.jwt == nil {
		return tokenPair{}, s.err
	}
	access, exp, err := s.jwt.Issue(IDString(u.ID), u.Roles)
	if err != nil {
		return tokenPair{}, err
	}
	refresh, err := semiiauth.NewToken()
	if err != nil {
		return tokenPair{}, err
	}
	t := now()
	err = q.CreateRefreshToken(r.Context(), sqlc.CreateRefreshTokenParams{
		TokenHash: refresh.Hash, FamilyID: family, UserID: u.ID,
		ExpiresAt: t.Add(s.svc.cfg.Auth.RefreshTTL), CreatedAt: t,
	})
	if err != nil {
		return tokenPair{}, fmt.Errorf("auth refresh token: %w", err)
	}
	return tokenPair{AccessToken: access, RefreshToken: refresh.Raw, TokenType: "Bearer",
		ExpiresIn: int(exp.Sub(t).Seconds())}, nil
}

type refreshInput struct {
	RefreshToken string `json:"refresh_token" validate:"required,max=256"`
}

// refresh handles POST /auth/refresh: it consumes the refresh token and
// returns a new pair in the same family. Presenting an already used token
// revokes the whole family (token theft detection).
func (s *jwtStrategy) refresh(w http.ResponseWriter, r *http.Request) error {
	if !s.svc.enabled("jwt") {
		return errStrategyOff
	}
	in, err := web.Decode[refreshInput](r)
	if err != nil {
		return err
	}
	hash := semiiauth.HashToken(in.RefreshToken)
	t := now()
	var pair tokenPair
	err = pgxdb.WithTx(r.Context(), s.svc.pool, func(tx pgx.Tx) error {
		q := s.svc.q.WithTx(tx)
		row, err := q.ConsumeRefreshToken(r.Context(), sqlc.ConsumeRefreshTokenParams{TokenHash: hash, Now: t})
		if errors.Is(err, pgx.ErrNoRows) {
			return s.rejected(r, q, hash)
		}
		if err != nil {
			return err
		}
		if t.After(row.ExpiresAt) {
			return semiiauth.ErrTokenExpired
		}
		u, err := q.GetUser(r.Context(), row.UserID)
		if err != nil {
			return err
		}
		pair, err = s.issue(r, q, UserFromRow(u), row.FamilyID)
		return err
	})
	if err != nil {
		return err
	}
	return web.JSON(w, http.StatusOK, pair)
}

// rejected explains why a refresh token could not be consumed, revoking
// its family when it was already used.
func (s *jwtStrategy) rejected(r *http.Request, q *sqlc.Queries, hash string) error {
	tok, err := q.GetRefreshToken(r.Context(), hash)
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return semiiauth.ErrInvalidCredentials
	case err != nil:
		return err
	case tok.RevokedAt != nil:
		return semiiauth.ErrInvalidCredentials
	}
	// Used before: revoke the family with the pool, so the revocation
	// survives the surrounding transaction's rollback.
	if err := s.svc.q.RevokeRefreshFamily(r.Context(), sqlc.RevokeRefreshFamilyParams{FamilyID: tok.FamilyID, Now: now()}); err != nil {
		return err
	}
	s.svc.log.Warn("refresh token reuse; family revoked", "user_id", IDString(tok.UserID))
	return semiiauth.ErrTokenReused
}

// logout revokes the family of the refresh token in the body, if it
// belongs to the caller.
func (s *jwtStrategy) logout(_ http.ResponseWriter, r *http.Request, p *semiiauth.Principal, in logoutInput) error {
	if in.RefreshToken == "" || p == nil {
		return nil
	}
	tok, err := s.svc.q.GetRefreshToken(r.Context(), semiiauth.HashToken(in.RefreshToken))
	if errors.Is(err, pgx.ErrNoRows) || (err == nil && IDString(tok.UserID) != p.ID) {
		return nil
	}
	if err != nil {
		return err
	}
	return s.svc.q.RevokeRefreshFamily(r.Context(), sqlc.RevokeRefreshFamilyParams{FamilyID: tok.FamilyID, Now: now()})
}

func (s *jwtStrategy) revokeAll(r *http.Request, q *sqlc.Queries, userID {{.IDGo}}) error {
	return q.RevokeUserRefreshTokens(r.Context(), sqlc.RevokeUserRefreshTokensParams{UserID: userID, Now: now()})
}
