package auth

import (
	"context"
	"errors"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgxpool"
	"{{.Module}}/db/sqlc"
	"{{.Semii}}/db/pgxdb"
	"time"
)

// store persists accounts on Postgres with the sqlc queries in
// db/queries/auth_*.sql. Each strategy adds its methods in its own
// *_store.go file.
type store struct {
	pool *pgxpool.Pool
	q    *sqlc.Queries
}

func newStore(pool *pgxpool.Pool) *store { return &store{pool: pool, q: sqlc.New(pool)} }

type txKey struct{}

// queries returns queries bound to the transaction in ctx, if any.
func (s *store) queries(ctx context.Context) *sqlc.Queries {
	if tx, ok := ctx.Value(txKey{}).(pgx.Tx); ok {
		return s.q.WithTx(tx)
	}
	return s.q
}

// InTx runs fn in a transaction carried by its context.
func (s *store) InTx(ctx context.Context, fn func(ctx context.Context) error) error {
	return pgxdb.WithTx(ctx, s.pool, func(tx pgx.Tx) error { return fn(context.WithValue(ctx, txKey{}, tx)) })
}

func userFromRow(r sqlc.User) User {
	roles := r.Roles
	if roles == nil {
		roles = []string{}
	}
	return User{
		ID: r.ID, Email: r.Email, Roles: roles, EmailVerified: r.EmailVerifiedAt != nil, CreatedAt: r.CreatedAt,
		passwordHash: r.PasswordHash, failedLogins: r.FailedLogins, lockedUntil: r.LockedUntil,
	}
}

// CreateUser inserts u; created is false when the email is taken.
func (s *store) CreateUser(ctx context.Context, u newUser) (User, bool, error) {
	row, err := s.queries(ctx).CreateUser(ctx, sqlc.CreateUserParams{
{{- if .UUID}}
		ID: newID(),
{{- end}}
		Email: u.Email, PasswordHash: u.PasswordHash, Roles: []string{}, CreatedAt: u.CreatedAt, UpdatedAt: u.CreatedAt,
	})
	if errors.Is(err, pgx.ErrNoRows) {
		existing, err := s.UserByEmail(ctx, u.Email)
		return existing, false, err
	}
	if err != nil {
		return User{}, false, pgxdb.MapError(err)
	}
	return userFromRow(row), true, nil
}

func (s *store) UserByEmail(ctx context.Context, email string) (User, error) {
	row, err := s.queries(ctx).GetUserByEmail(ctx, email)
	if err != nil {
		return User{}, pgxdb.MapError(err)
	}
	return userFromRow(row), nil
}

func (s *store) UserByID(ctx context.Context, id {{.IDGo}}) (User, error) {
	row, err := s.queries(ctx).GetUser(ctx, id)
	if err != nil {
		return User{}, pgxdb.MapError(err)
	}
	return userFromRow(row), nil
}

func (s *store) RecordLoginFailure(ctx context.Context, id {{.IDGo}}, at time.Time) (int, error) {
	n, err := s.queries(ctx).RecordLoginFailure(ctx, sqlc.RecordLoginFailureParams{ID: id, Now: at})
	return int(n), err
}

func (s *store) LockUser(ctx context.Context, id {{.IDGo}}, until time.Time) error {
	return s.queries(ctx).LockUser(ctx, sqlc.LockUserParams{ID: id, Until: until})
}

func (s *store) RecordLoginSuccess(ctx context.Context, id {{.IDGo}}) error {
	return s.queries(ctx).RecordLoginSuccess(ctx, id)
}

func (s *store) UpdatePassword(ctx context.Context, id {{.IDGo}}, hash string, at time.Time) error {
	return s.queries(ctx).UpdatePasswordHash(ctx, sqlc.UpdatePasswordHashParams{ID: id, PasswordHash: hash, Now: at})
}

func (s *store) MarkEmailVerified(ctx context.Context, id {{.IDGo}}, at time.Time) error {
	return s.queries(ctx).MarkEmailVerified(ctx, sqlc.MarkEmailVerifiedParams{ID: id, Now: at})
}

func (s *store) GrantRole(ctx context.Context, id {{.IDGo}}, role string) error {
	return s.queries(ctx).GrantRole(ctx, sqlc.GrantRoleParams{ID: id, Role: role})
}

func (s *store) CreateAuthToken(ctx context.Context, t authToken) error {
	return s.queries(ctx).CreateAuthToken(ctx, sqlc.CreateAuthTokenParams{
		TokenHash: t.Hash, UserID: t.UserID, Kind: t.Kind, ExpiresAt: t.ExpiresAt, CreatedAt: t.CreatedAt,
	})
}

// ConsumeAuthToken marks an unused, unexpired token used (atomically) and
// returns its user; db.ErrNotFound otherwise.
func (s *store) ConsumeAuthToken(ctx context.Context, hash, kind string, at time.Time) ({{.IDGo}}, error) {
	id, err := s.queries(ctx).ConsumeAuthToken(ctx, sqlc.ConsumeAuthTokenParams{TokenHash: hash, Kind: kind, Now: at})
	return id, pgxdb.MapError(err)
}
