package auth

import (
	"context"
	"errors"
	"fmt"
	"net/http"
	"time"

	"github.com/jackc/pgx/v5"
	"{{.Module}}/db/sqlc"
	semiiauth "{{.Semii}}/auth"
	"{{.Semii}}/db"
	"{{.Semii}}/web"
)

// sessionStrategy signs users in with a server-side session cookie.
type sessionStrategy struct {
	svc      *Service
	sessions *semiiauth.Sessions
}

func newSessionStrategy(svc *Service) *sessionStrategy {
	store := sessionStore{svc.q}
	return &sessionStrategy{svc: svc, sessions: semiiauth.NewSessions(store, svc.cfg.Auth, svc.cfg.Env, svc.cfg.HTTP.CORS.AllowedOrigins...)}
}

func (s *sessionStrategy) name() string                           { return "session" }
func (s *sessionStrategy) authenticator() semiiauth.Authenticator { return s.sessions }
func (s *sessionStrategy) routes(*web.Router)                     {}

// login replaces any session the browser already had (no fixation) with a
// new one and sets its cookie.
func (s *sessionStrategy) login(w http.ResponseWriter, r *http.Request, u User) error {
	if old := semiiauth.CookieIDHash(r); old != "" {
		if err := s.svc.q.DeleteSession(r.Context(), old); err != nil {
			return err
		}
	}
	tok, cookie, err := s.sessions.New()
	if err != nil {
		return err
	}
	t := now()
	err = s.svc.q.CreateSession(r.Context(), sqlc.CreateSessionParams{
		IDHash: tok.Hash, UserID: u.ID, CreatedAt: t, LastSeenAt: t, ExpiresAt: s.sessions.ExpiresAt(),
		UserAgent: truncate(r.UserAgent(), 512), Ip: web.ClientIP(r).String(),
	})
	if err != nil {
		return fmt.Errorf("auth session: %w", err)
	}
	http.SetCookie(w, cookie)
	return web.JSON(w, http.StatusOK, map[string]any{"user": u})
}

func (s *sessionStrategy) logout(w http.ResponseWriter, r *http.Request, p *semiiauth.Principal, _ logoutInput) error {
	idHash, _ := p.Claims[semiiauth.IDHashClaim].(string)
	if idHash == "" {
		return nil
	}
	if err := s.svc.q.DeleteSession(r.Context(), idHash); err != nil {
		return err
	}
	s.sessions.ClearCookie(w)
	return nil
}

func (s *sessionStrategy) revokeAll(r *http.Request, q *sqlc.Queries, userID {{.IDGo}}) error {
	return q.DeleteUserSessions(r.Context(), userID)
}

// sessionStore adapts the sqlc queries to semiiauth.SessionStore.
type sessionStore struct{ q *sqlc.Queries }

func (st sessionStore) FindSession(ctx context.Context, idHash string) (semiiauth.Session, error) {
	row, err := st.q.FindSession(ctx, idHash)
	if errors.Is(err, pgx.ErrNoRows) {
		return semiiauth.Session{}, db.ErrNotFound
	}
	if err != nil {
		return semiiauth.Session{}, err
	}
	return semiiauth.Session{
		UserID: IDString(row.UserID), Roles: row.Roles,
		CreatedAt: row.CreatedAt, LastSeenAt: row.LastSeenAt, ExpiresAt: row.ExpiresAt,
	}, nil
}

func (st sessionStore) TouchSession(ctx context.Context, idHash string, at time.Time) error {
	return st.q.TouchSession(ctx, sqlc.TouchSessionParams{IDHash: idHash, LastSeenAt: at})
}

func (st sessionStore) DeleteSession(ctx context.Context, idHash string) error {
	return st.q.DeleteSession(ctx, idHash)
}

func truncate(s string, n int) string {
	if len(s) > n {
		return s[:n]
	}
	return s
}
