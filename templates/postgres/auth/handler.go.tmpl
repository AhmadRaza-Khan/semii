package auth

import (
	"net/http"

	semiiauth "{{.Semii}}/auth"
	"{{.Semii}}/web"
)

// Handler serves /auth.
type Handler struct {
	svc        *Service
	strategies []strategy // every generated strategy, enabled or not
}

type registerInput struct {
	Email    string `json:"email" validate:"required,email,max=254"`
	Password string `json:"password" validate:"required"`
}

type loginInput struct {
	Email    string `json:"email" validate:"required,max=254"`
	Password string `json:"password" validate:"required,max=1024"`
	// Mode picks the credential when several sign-in strategies are
	// enabled: "session" (cookie) or "token" (JWT). Default: the first
	// enabled one in AUTH_STRATEGIES.
	Mode string `json:"mode" validate:"omitempty,oneof=session token"`
}

type logoutInput struct {
	RefreshToken string `json:"refresh_token"`
}

type emailInput struct {
	Email string `json:"email" validate:"required,max=254"`
}

type resetInput struct {
	Token    string `json:"token" validate:"required,max=256"`
	Password string `json:"password" validate:"required"`
}

type tokenInput struct {
	Token string `json:"token" validate:"required,max=256"`
}

type message struct {
	Message string `json:"message"`
}

// Register handles POST /auth/register.
func (h *Handler) Register(w http.ResponseWriter, r *http.Request) error {
	if err := h.svc.limit(r, "register"); err != nil {
		return err
	}
	in, err := web.Decode[registerInput](r)
	if err != nil {
		return err
	}
	if err := h.svc.Register(r.Context(), in.Email, in.Password); err != nil {
		return err
	}
	return web.JSON(w, http.StatusCreated, message{"Account created. Check your email to verify your address."})
}

// Login handles POST /auth/login.
func (h *Handler) Login(w http.ResponseWriter, r *http.Request) error {
	if err := h.svc.limit(r, "login"); err != nil {
		return err
	}
	in, err := web.Decode[loginInput](r)
	if err != nil {
		return err
	}
	st, err := h.loginStrategy(in.Mode)
	if err != nil {
		return err
	}
	u, err := h.svc.Authenticate(r.Context(), in.Email, in.Password)
	if err != nil {
		return err
	}
	return st.login(w, r, u)
}

// loginStrategy picks the enabled strategy that answers a sign-in.
func (h *Handler) loginStrategy(mode string) (strategy, error) {
	names := map[string]string{"session": "session", "token": "jwt"}
	for _, st := range h.svc.active {
		if mode != "" && names[mode] != st.name() {
			continue
		}
		if st.name() == "session" || st.name() == "jwt" {
			return st, nil
		}
	}
	return nil, errStrategyOff
}

// Logout handles POST /auth/logout: it revokes the current session or the
// given refresh token's family. Access tokens stay valid until they expire.
func (h *Handler) Logout(w http.ResponseWriter, r *http.Request) error {
	var in logoutInput
	if r.ContentLength != 0 {
		var err error
		if in, err = web.Decode[logoutInput](r); err != nil {
			return err
		}
	}
	p, _ := semiiauth.FromContext(r.Context())
	for _, st := range h.svc.active {
		if err := st.logout(w, r, p, in); err != nil {
			return err
		}
	}
	return web.NoContent(w)
}

// Me handles GET /auth/me.
func (h *Handler) Me(w http.ResponseWriter, r *http.Request) error {
	id, err := userID(r)
	if err != nil {
		return err
	}
	u, err := h.svc.User(r.Context(), id)
	if err != nil {
		return err
	}
	return web.JSON(w, http.StatusOK, u)
}

// Forgot handles POST /auth/password/forgot: always 202.
func (h *Handler) Forgot(w http.ResponseWriter, r *http.Request) error {
	if err := h.svc.limit(r, "forgot"); err != nil {
		return err
	}
	in, err := web.Decode[emailInput](r)
	if err != nil {
		return err
	}
	h.svc.Forgot(in.Email)
	return web.JSON(w, http.StatusAccepted, message{"If the address has an account, a reset link is on its way."})
}

// Reset handles POST /auth/password/reset.
func (h *Handler) Reset(w http.ResponseWriter, r *http.Request) error {
	in, err := web.Decode[resetInput](r)
	if err != nil {
		return err
	}
	if err := h.svc.ResetPassword(r, in.Token, in.Password); err != nil {
		return err
	}
	return web.NoContent(w)
}

// VerifyEmail handles POST /auth/email/verify.
func (h *Handler) VerifyEmail(w http.ResponseWriter, r *http.Request) error {
	in, err := web.Decode[tokenInput](r)
	if err != nil {
		return err
	}
	if err := h.svc.VerifyEmail(r.Context(), in.Token); err != nil {
		return err
	}
	return web.NoContent(w)
}

// Resend handles POST /auth/email/resend.
func (h *Handler) Resend(w http.ResponseWriter, r *http.Request) error {
	id, err := userID(r)
	if err != nil {
		return err
	}
	if err := h.svc.ResendVerification(r.Context(), id); err != nil {
		return err
	}
	return web.JSON(w, http.StatusAccepted, message{"If the address is unverified, a new link is on its way."})
}
