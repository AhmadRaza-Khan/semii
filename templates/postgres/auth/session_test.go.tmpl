package auth

import (
	"net/http"
	"testing"

	semiiauth "{{.Semii}}/auth"
	"{{.Semii}}/testkit"
)

func sessionCookie(t *testing.T, res interface{ HeaderValue(string) string }) string {
	t.Helper()
	c, err := http.ParseSetCookie(res.HeaderValue("Set-Cookie"))
	if err != nil || c.Name != semiiauth.SessionCookie || !c.HttpOnly || c.SameSite != http.SameSiteLaxMode {
		t.Fatalf("session cookie: %+v %v", c, err)
	}
	return c.Value
}

func TestSessionLoginLogout(t *testing.T) {
	e := newTestEnv(t)
	e.register("s@x.io")
	sessionCookie(t, e.login("s@x.io", strongPassword, "session").ExpectStatus(http.StatusOK).ExpectJSON(map[string]any{"user": map[string]any{"email": "s@x.io"}}))
	e.c.GET("/auth/me").Do().ExpectStatus(http.StatusOK)
	e.c.POST("/auth/logout").Header("Sec-Fetch-Site", "same-origin").Do().ExpectStatus(http.StatusNoContent)
	e.c.GET("/auth/me").Do().ExpectProblem(http.StatusUnauthorized, "unauthenticated")
}

// Checklist: session fixation impossible (rotation on login).
func TestSessionFixation(t *testing.T) {
	e := newTestEnv(t)
	e.register("fix@x.io")
	planted := &http.Cookie{Name: semiiauth.SessionCookie, Value: "attacker-chosen-value"}
	res := e.c.POST("/auth/login").Cookie(planted).Header("Sec-Fetch-Site", "same-origin").
		JSON(map[string]string{"email": "fix@x.io", "password": strongPassword, "mode": "session"}).Do().ExpectStatus(http.StatusOK)
	first := sessionCookie(t, res)
	if first == planted.Value {
		t.Fatal("login kept the planted session id")
	}
	// Logging in again replaces the previous session.
	second := sessionCookie(t, e.login("fix@x.io", strongPassword, "session").ExpectStatus(http.StatusOK))
	if second == first {
		t.Fatal("session id not rotated")
	}
	// Neither the planted id nor the replaced one authenticates anyone.
	for _, old := range []string{planted.Value, first} {
		testkit.NewClient(t, e.handler).GET("/auth/me").Cookie(&http.Cookie{Name: semiiauth.SessionCookie, Value: old}).Do().
			ExpectProblem(http.StatusUnauthorized, "unauthenticated")
	}
	e.c.GET("/auth/me").Do().ExpectStatus(http.StatusOK) // the jar holds the current cookie
}

// Checklist: CSRF rejected for cross-site cookie requests.
func TestSessionCSRF(t *testing.T) {
	e := newTestEnv(t)
	e.register("csrf@x.io")
	e.login("csrf@x.io", strongPassword, "session").ExpectStatus(http.StatusOK)
	e.c.POST("/auth/logout").Header("Sec-Fetch-Site", "cross-site").Do().ExpectProblem(http.StatusForbidden, "csrf_rejected")
	e.c.POST("/auth/logout").Header("Origin", "https://evil.example").Do().ExpectProblem(http.StatusForbidden, "csrf_rejected")
	e.c.POST("/auth/logout").Do().ExpectProblem(http.StatusForbidden, "csrf_rejected")
	e.c.POST("/auth/logout").Header("Origin", "https://app.test").Do().ExpectStatus(http.StatusNoContent)
}

// Checklist: password reset revokes all sessions.
func TestResetRevokesSessions(t *testing.T) {
	e := newTestEnv(t)
	e.register("rs@x.io")
	e.login("rs@x.io", strongPassword, "session").ExpectStatus(http.StatusOK)
	e.c.GET("/auth/me").Do().ExpectStatus(http.StatusOK)
	e.c.POST("/auth/password/forgot").Header("Sec-Fetch-Site", "same-origin").JSON(map[string]string{"email": "rs@x.io"}).Do().ExpectStatus(http.StatusAccepted)
	tok := e.mailedToken("reset", "rs@x.io")
	e.c.POST("/auth/password/reset").Header("Sec-Fetch-Site", "same-origin").
		JSON(map[string]string{"token": tok, "password": "a-brand-new-passphrase"}).Do().ExpectStatus(http.StatusNoContent)
	e.c.GET("/auth/me").Do().ExpectProblem(http.StatusUnauthorized, "unauthenticated")
}
