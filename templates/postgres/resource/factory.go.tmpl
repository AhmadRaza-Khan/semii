// {{.Name}}Input returns a valid {{.Pkg}}.CreateInput with unique values,
// creating referenced rows as needed.
func {{.Name}}Input(t testing.TB, q *sqlc.Queries) {{.Pkg}}.CreateInput {
	t.Helper()
{{- if .UsesSeq}}
	n := Next()
{{- end}}
{{- range .Refs}}
	{{camel .Col}} := {{.Ref.Name}}(t, q).ID
{{- end}}
	return {{.Pkg}}.CreateInput{
{{- range .Fields}}
{{- if .IsRef}}
		{{.GoName}}: {{if .Null}}&{{end}}{{camel .Col}},
{{- else}}
		{{.GoName}}: {{.SampleFor "n" "Ptr"}},
{{- end}}
{{- end}}
	}
}

// {{.Name}} creates a {{.Var}} through the SQL repository. opts adjust the
// input before it is stored.
func {{.Name}}(t testing.TB, q *sqlc.Queries, opts ...func(*{{.Pkg}}.CreateInput)) {{.Pkg}}.{{.Name}} {
	t.Helper()
	in := {{.Name}}Input(t, q)
	for _, opt := range opts {
		opt(&in)
	}
	out, err := {{.Pkg}}.NewSQLRepo(q).Create(context.Background(), in)
	if err != nil {
		t.Fatalf("factory.{{.Name}}: %v", err)
	}
	return out
}
