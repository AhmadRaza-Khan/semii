package {{.Pkg}}

import (
	"encoding/json"
	"time"

	"github.com/google/uuid"
	"github.com/shopspring/decimal"
	"{{.Semii}}/web"
)

// CreateInput is the body of POST {{.Route}}.
type CreateInput struct {
{{- range .Fields}}
	{{.GoName}} {{.CreateType}} {{tag "json" .Col "validate" .CreateValidate}}
{{- end}}
}

// UpdateInput is the body of PATCH {{.Route}}/{id}. Absent fields are left
// unchanged{{if .HasNull}}; nullable fields accept null to clear them{{end}}.
type UpdateInput struct {
{{- range .Fields}}
	{{.GoName}} {{.UpdateType}} {{tag "json" .Col "validate" .UpdateValidate}}
{{- end}}
}

// ListFilter holds the optional query filters of GET {{.Route}}.
type ListFilter struct {
{{- range .Filters}}
	{{.GoName}} {{.FilterType}} `query:"{{.Col}}"`
{{- end}}
}
