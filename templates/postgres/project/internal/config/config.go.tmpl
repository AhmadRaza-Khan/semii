// Package config defines the application's typed configuration.
package config

import (
	"net/netip"
	"time"

	semiiconfig "{{.Semii}}/config"
	"{{.Semii}}/web"
)

// Config is loaded once in main and passed down explicitly.
type Config struct {
	Env         string             `env:"SEMII_ENV" default:"development" validate:"oneof=development test production"`
	LogLevel    string             `env:"LOG_LEVEL" default:"info" validate:"oneof=debug info warn error"`
	DatabaseURL semiiconfig.Secret `env:"DATABASE_URL" validate:"required"`
	DB          DBConfig           `envPrefix:"DB_"`
	HTTP        HTTPConfig         `envPrefix:"HTTP_"`
	// semii:config:start
	// semii:config:end
}

// DBConfig tunes the database pool and migrations.
type DBConfig struct {
	MaxConns              int32 `env:"MAX_CONNS"`
	AutoMigrate           bool  `env:"AUTO_MIGRATE" default:"false"`
	AutoMigrateProduction bool  `env:"AUTO_MIGRATE_PRODUCTION" default:"false"`
}

// HTTPConfig configures the server and middleware.
type HTTPConfig struct {
	Addr           string         `env:"ADDR" default:":8080" validate:"hostname_port"`
	MaxBodyBytes   int64          `env:"MAX_BODY_BYTES" default:"1048576"`
	HandlerTimeout time.Duration  `env:"HANDLER_TIMEOUT" default:"30s"`
	// DrainDelay keeps /readyz failing this long before shutdown so load
	// balancers stop routing; negative disables it (semii dev does).
	DrainDelay     time.Duration  `env:"DRAIN_DELAY" default:"5s"`
	TrustedProxies []netip.Prefix `env:"TRUSTED_PROXIES"`
	CORS           web.CORSConfig `envPrefix:"CORS_"`
}

// Load reads defaults, .env files and the environment (see package
// semii/config for precedence) and validates the result.
func Load(opts ...semiiconfig.Option) (Config, error) {
	return semiiconfig.Load[Config](opts...)
}
