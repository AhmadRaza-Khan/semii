// Package seeds fills a development database. Run it with `semii db seed`.
package seeds

import (
	"context"
	"log/slog"

	"github.com/jackc/pgx/v5/pgxpool"
)

// Deps are the dependencies seeds may use.
type Deps struct {
	Pool *pgxpool.Pool
	Log  *slog.Logger
}

// Seed inserts development data. It must be idempotent (upsert by natural
// key) because it may run more than once.
func Seed(ctx context.Context, d Deps) error {
	d.Log.Info("nothing to seed yet; edit db/seeds/seed.go")
	return nil
}
