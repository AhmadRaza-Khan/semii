// FindAPIKey implements semiiauth.APIKeyStore.
func (s *store) FindAPIKey(ctx context.Context, prefix string) (semiiauth.APIKey, error) {
	row, err := s.queries(ctx).FindAPIKeyByPrefix(ctx, prefix)
	if err != nil {
		return semiiauth.APIKey{}, sqldb.MapError(err)
	}
	return semiiauth.APIKey{
		ID: fmt.Sprint(row.ID), OwnerID: IDString(row.UserID), Scopes: decodeList(row.Scopes), SecretHash: row.SecretHash,
		ExpiresAt: row.ExpiresAt, RevokedAt: row.RevokedAt, LastUsedAt: row.LastUsedAt,
	}, nil
}

// TouchAPIKey implements semiiauth.APIKeyStore.
func (s *store) TouchAPIKey(ctx context.Context, id string, at time.Time) error {
{{- if .SeqID}}
	keyID, err := strconv.ParseInt(id, 10, 64)
{{- else}}
	keyID, err := uuid.Parse(id)
{{- end}}
	if err != nil {
		return err
	}
	return s.queries(ctx).TouchAPIKey(ctx, sqlc.TouchAPIKeyParams{LastUsedAt: &at, ID: keyID})
}

func (s *store) ListAPIKeys(ctx context.Context, owner {{.IDGo}}) ([]APIKey, error) {
	rows, err := s.queries(ctx).ListAPIKeys(ctx, owner)
	if err != nil {
		return nil, err
	}
	keys := make([]APIKey, len(rows))
	for i, row := range rows {
		keys[i] = apiKeyFromRow(row)
	}
	return keys, nil
}

// RevokeAPIKey revokes id if owner owns it, returning how many keys changed.
func (s *store) RevokeAPIKey(ctx context.Context, id, owner {{.IDGo}}, at time.Time) (int64, error) {
	return s.queries(ctx).RevokeAPIKey(ctx, sqlc.RevokeAPIKeyParams{RevokedAt: &at, ID: id, UserID: owner})
}

// expireAPIKey sets a key's expiry (tests).
func (s *store) expireAPIKey(ctx context.Context, prefix string, at time.Time) error {
	return s.queries(ctx).ExpireAPIKey(ctx, sqlc.ExpireAPIKeyParams{ExpiresAt: &at, Prefix: prefix})
}
