-- Refresh tokens. Generated by semii {{.Version}}; edit freely.

-- name: CreateRefreshToken :exec
INSERT INTO refresh_tokens (token_hash, family_id, user_id, expires_at, created_at) VALUES (?, ?, ?, ?, ?);

-- name: UseRefreshToken :execrows
-- Single use: only an unused, unrevoked token is updated.
UPDATE refresh_tokens SET used_at = ? WHERE token_hash = ? AND used_at IS NULL AND revoked_at IS NULL;

-- name: GetRefreshToken :one
SELECT * FROM refresh_tokens WHERE token_hash = ?;

-- name: RevokeRefreshFamily :exec
UPDATE refresh_tokens SET revoked_at = ? WHERE family_id = ? AND revoked_at IS NULL;

-- name: RevokeUserRefreshTokens :exec
UPDATE refresh_tokens SET revoked_at = ? WHERE user_id = ? AND revoked_at IS NULL;
