package auth

import (
	"context"
	"time"

	"github.com/google/uuid"
	"{{.Module}}/db/sqlc"
	"{{.Semii}}/db"
	"{{.Semii}}/db/sqldb"
)

func (s *store) CreateRefreshToken(ctx context.Context, r refreshRow) error {
	return s.queries(ctx).CreateRefreshToken(ctx, sqlc.CreateRefreshTokenParams{
		TokenHash: r.Hash, FamilyID: r.FamilyID, UserID: r.UserID, ExpiresAt: r.ExpiresAt, CreatedAt: r.CreatedAt,
	})
}

// ConsumeRefreshToken marks an unused, unrevoked token used (one atomic
// UPDATE); db.ErrNotFound otherwise.
func (s *store) ConsumeRefreshToken(ctx context.Context, hash string, at time.Time) (refreshRow, error) {
	n, err := s.queries(ctx).UseRefreshToken(ctx, sqlc.UseRefreshTokenParams{UsedAt: &at, TokenHash: hash})
	if err != nil {
		return refreshRow{}, err
	}
	if n == 0 {
		return refreshRow{}, db.ErrNotFound
	}
	return s.GetRefreshToken(ctx, hash)
}

func (s *store) GetRefreshToken(ctx context.Context, hash string) (refreshRow, error) {
	row, err := s.queries(ctx).GetRefreshToken(ctx, hash)
	if err != nil {
		return refreshRow{}, sqldb.MapError(err)
	}
	return refreshRow{Hash: row.TokenHash, FamilyID: row.FamilyID, UserID: row.UserID, ExpiresAt: row.ExpiresAt,
		CreatedAt: row.CreatedAt, UsedAt: row.UsedAt, RevokedAt: row.RevokedAt}, nil
}

func (s *store) RevokeRefreshFamily(ctx context.Context, family uuid.UUID, at time.Time) error {
	return s.queries(ctx).RevokeRefreshFamily(ctx, sqlc.RevokeRefreshFamilyParams{RevokedAt: &at, FamilyID: family})
}

func (s *store) RevokeUserRefreshTokens(ctx context.Context, id {{.IDGo}}, at time.Time) error {
	return s.queries(ctx).RevokeUserRefreshTokens(ctx, sqlc.RevokeUserRefreshTokensParams{RevokedAt: &at, UserID: id})
}
