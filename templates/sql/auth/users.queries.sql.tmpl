-- Accounts and one-time tokens. Generated by semii {{.Version}}; edit freely.

-- name: CreateUser :execresult
-- Affects no row when the email is taken (no enumeration in register).
INSERT INTO users ({{if not .SeqID}}id, {{end}}email, password_hash, roles, created_at, updated_at)
VALUES ({{if not .SeqID}}?, {{end}}?, ?, ?, ?, ?)
{{- if .MySQL}}
ON DUPLICATE KEY UPDATE email = email;
{{- else}}
ON CONFLICT (email) DO NOTHING;
{{- end}}

-- name: GetUser :one
SELECT * FROM users WHERE id = ?;

-- name: GetUserByEmail :one
SELECT * FROM users WHERE email = ?;

-- name: IncrementFailedLogins :exec
UPDATE users SET failed_logins = failed_logins + 1, updated_at = ? WHERE id = ?;

-- name: GetFailedLogins :one
SELECT failed_logins FROM users WHERE id = ?;

-- name: LockUser :exec
UPDATE users SET locked_until = ? WHERE id = ?;

-- name: RecordLoginSuccess :exec
UPDATE users SET failed_logins = 0, locked_until = NULL WHERE id = ?;

-- name: UpdatePasswordHash :exec
UPDATE users SET password_hash = ?, failed_logins = 0, locked_until = NULL, updated_at = ? WHERE id = ?;

-- name: MarkEmailVerified :exec
UPDATE users SET email_verified_at = ?, updated_at = ? WHERE id = ? AND email_verified_at IS NULL;

-- name: SetRoles :exec
UPDATE users SET roles = ? WHERE id = ?;

-- name: CreateAuthToken :exec
INSERT INTO auth_tokens (token_hash, user_id, kind, expires_at, created_at) VALUES (?, ?, ?, ?, ?);

-- name: UseAuthToken :execrows
-- Single use: only an unused, unexpired token is updated.
UPDATE auth_tokens SET used_at = ?
WHERE token_hash = ? AND kind = ? AND used_at IS NULL AND expires_at > ?;

-- name: GetAuthTokenUser :one
SELECT user_id FROM auth_tokens WHERE token_hash = ?;
