-- API keys. Generated by semii {{.Version}}; edit freely.

-- name: CreateAPIKey :execresult
INSERT INTO api_keys ({{if not .SeqID}}id, {{end}}user_id, name, prefix, secret_hash, scopes, expires_at, created_at)
VALUES ({{if not .SeqID}}?, {{end}}?, ?, ?, ?, ?, ?, ?);

-- name: GetAPIKey :one
SELECT * FROM api_keys WHERE id = ?;

-- name: FindAPIKeyByPrefix :one
SELECT * FROM api_keys WHERE prefix = ?;

-- name: TouchAPIKey :exec
UPDATE api_keys SET last_used_at = ? WHERE id = ?;

-- name: ListAPIKeys :many
SELECT * FROM api_keys WHERE user_id = ? AND revoked_at IS NULL ORDER BY created_at DESC;

-- name: RevokeAPIKey :execrows
-- Scoped to the owner, so one user cannot revoke another's key.
UPDATE api_keys SET revoked_at = ? WHERE id = ? AND user_id = ? AND revoked_at IS NULL;

-- name: ExpireAPIKey :exec
-- Used by tests to simulate expiry.
UPDATE api_keys SET expires_at = ? WHERE prefix = ?;
