-- Queries for {{.Table}}, compiled by sqlc into db/sqlc. Generated by semii {{.Version}}; edit freely.

-- name: Create{{.Name}} :{{if .SeqID}}execlastid{{else}}exec{{end}}
INSERT INTO {{.Table}} ({{.InsertColumns}})
VALUES ({{.InsertPlaceholders}});

-- name: Get{{.Name}} :one
SELECT * FROM {{.Table}}
WHERE id = ?{{if .SoftDelete}} AND deleted_at IS NULL{{end}};
{{- if .MySQL}}

-- name: Get{{.Name}}ForUpdate :one
SELECT * FROM {{.Table}}
WHERE id = ?{{if .SoftDelete}} AND deleted_at IS NULL{{end}}
FOR UPDATE;
{{- end}}

-- name: List{{.Plural}} :many
-- Optional filters and the cursor are switched on by their has_* flags.
SELECT * FROM {{.Table}}
WHERE ({{.Flag "has_cursor"}} OR created_at < sqlc.arg('after_created_at')
       OR (created_at = sqlc.arg('after_created_at') AND id < sqlc.arg('after_id')))
{{- range .Filters}}
  AND ({{$.Flag (printf "has_%s" .Col)}} OR {{.Col}} = sqlc.arg('{{.Col}}'))
{{- end}}
{{- if .SoftDelete}}
  AND deleted_at IS NULL
{{- end}}
ORDER BY created_at DESC, id DESC
LIMIT {{if .MySQL}}?{{else}}sqlc.arg('lim'){{end}};

-- name: Update{{.Name}} :execrows
-- Writes the whole row; the repository applies PATCH semantics in Go.
UPDATE {{.Table}} SET
{{- range .Fields}}
  {{.Col}} = ?,
{{- end}}
  updated_at = ?
WHERE id = ?{{if .SoftDelete}} AND deleted_at IS NULL{{end}};

-- name: Delete{{.Name}} :execrows
{{- if .SoftDelete}}
UPDATE {{.Table}} SET deleted_at = ? WHERE id = ? AND deleted_at IS NULL;
{{- else}}
DELETE FROM {{.Table}} WHERE id = ?;
{{- end}}

-- name: Count{{.Plural}} :one
SELECT count(*) FROM {{.Table}}{{if .SoftDelete}} WHERE deleted_at IS NULL{{end}};
