package auth

import (
	"context"
	"errors"
	"time"

	"go.mongodb.org/mongo-driver/v2/bson"
	"go.mongodb.org/mongo-driver/v2/mongo"
	"go.mongodb.org/mongo-driver/v2/mongo/options"
	"{{.Semii}}/db"
	"{{.Semii}}/db/mongodb"
)

// store persists accounts in MongoDB. Each strategy adds its methods (and
// its collection's indexes) in its own *_store.go file.
type store struct {
	db *mongo.Database
}

func newStore(d *mongo.Database) *store { return &store{db: d} }

func (s *store) users() *mongo.Collection  { return s.db.Collection("users") }
func (s *store) tokens() *mongo.Collection { return s.db.Collection("auth_tokens") }

// InTx runs fn in a transaction (a replica set is required); operations
// using fn's context take part in it.
func (s *store) InTx(ctx context.Context, fn func(ctx context.Context) error) error {
	return mongodb.WithTx(ctx, s.db.Client(), fn)
}

// UserIndexes are the users collection's indexes.
func UserIndexes() []mongo.IndexModel {
	return []mongo.IndexModel{
		{Keys: bson.D{ {Key: "email", Value: 1} }, Options: options.Index().SetUnique(true)},
	}
}

// AuthTokenIndexes are the auth_tokens collection's indexes; expired
// tokens are removed by a TTL index.
func AuthTokenIndexes() []mongo.IndexModel {
	return []mongo.IndexModel{
		{Keys: bson.D{ {Key: "user_id", Value: 1} }},
		{Keys: bson.D{ {Key: "expires_at", Value: 1} }, Options: options.Index().SetExpireAfterSeconds(0)},
	}
}

type userDoc struct {
	ID              bson.ObjectID `bson:"_id"`
	Email           string        `bson:"email"`
	PasswordHash    string        `bson:"password_hash"`
	Roles           []string      `bson:"roles"`
	EmailVerifiedAt *time.Time    `bson:"email_verified_at,omitempty"`
	FailedLogins    int32         `bson:"failed_logins"`
	LockedUntil     *time.Time    `bson:"locked_until,omitempty"`
	CreatedAt       time.Time     `bson:"created_at"`
	UpdatedAt       time.Time     `bson:"updated_at"`
}

func (d userDoc) user() User {
	roles := d.Roles
	if roles == nil {
		roles = []string{}
	}
	return User{
		ID: d.ID, Email: d.Email, Roles: roles, EmailVerified: d.EmailVerifiedAt != nil, CreatedAt: d.CreatedAt.UTC(),
		passwordHash: d.PasswordHash, failedLogins: d.FailedLogins, lockedUntil: d.LockedUntil,
	}
}

type tokenDoc struct {
	Hash      string        `bson:"_id"`
	UserID    bson.ObjectID `bson:"user_id"`
	Kind      string        `bson:"kind"`
	ExpiresAt time.Time     `bson:"expires_at"`
	UsedAt    *time.Time    `bson:"used_at,omitempty"`
	CreatedAt time.Time     `bson:"created_at"`
}

// CreateUser inserts u; created is false when the email is taken.
func (s *store) CreateUser(ctx context.Context, u newUser) (User, bool, error) {
	d := userDoc{ID: bson.NewObjectID(), Email: u.Email, PasswordHash: u.PasswordHash, Roles: []string{},
		CreatedAt: u.CreatedAt, UpdatedAt: u.CreatedAt}
	if _, err := s.users().InsertOne(ctx, d); err != nil {
		if mongo.IsDuplicateKeyError(err) {
			existing, err := s.UserByEmail(ctx, u.Email)
			return existing, false, err
		}
		return User{}, false, err
	}
	return d.user(), true, nil
}

func (s *store) findUser(ctx context.Context, filter bson.M) (User, error) {
	var d userDoc
	if err := s.users().FindOne(ctx, filter).Decode(&d); err != nil {
		return User{}, mongodb.MapError(err)
	}
	return d.user(), nil
}

func (s *store) UserByEmail(ctx context.Context, email string) (User, error) {
	return s.findUser(ctx, bson.M{"email": email})
}

func (s *store) UserByID(ctx context.Context, id bson.ObjectID) (User, error) {
	return s.findUser(ctx, bson.M{"_id": id})
}

func (s *store) RecordLoginFailure(ctx context.Context, id bson.ObjectID, at time.Time) (int, error) {
	var d userDoc
	err := s.users().FindOneAndUpdate(ctx, bson.M{"_id": id},
		bson.M{"$inc": bson.M{"failed_logins": 1}, "$set": bson.M{"updated_at": at}},
		options.FindOneAndUpdate().SetReturnDocument(options.After)).Decode(&d)
	return int(d.FailedLogins), mongodb.MapError(err)
}

func (s *store) update(ctx context.Context, filter, update bson.M) error {
	_, err := s.users().UpdateOne(ctx, filter, update)
	return err
}

func (s *store) LockUser(ctx context.Context, id bson.ObjectID, until time.Time) error {
	return s.update(ctx, bson.M{"_id": id}, bson.M{"$set": bson.M{"locked_until": until}})
}

func (s *store) RecordLoginSuccess(ctx context.Context, id bson.ObjectID) error {
	return s.update(ctx, bson.M{"_id": id}, bson.M{"$set": bson.M{"failed_logins": 0}, "$unset": bson.M{"locked_until": ""}})
}

func (s *store) UpdatePassword(ctx context.Context, id bson.ObjectID, hash string, at time.Time) error {
	return s.update(ctx, bson.M{"_id": id}, bson.M{
		"$set":   bson.M{"password_hash": hash, "failed_logins": 0, "updated_at": at},
		"$unset": bson.M{"locked_until": ""},
	})
}

func (s *store) MarkEmailVerified(ctx context.Context, id bson.ObjectID, at time.Time) error {
	return s.update(ctx, bson.M{"_id": id, "email_verified_at": bson.M{"$exists": false}},
		bson.M{"$set": bson.M{"email_verified_at": at, "updated_at": at}})
}

func (s *store) GrantRole(ctx context.Context, id bson.ObjectID, role string) error {
	return s.update(ctx, bson.M{"_id": id}, bson.M{"$addToSet": bson.M{"roles": role}})
}

func (s *store) CreateAuthToken(ctx context.Context, t authToken) error {
	_, err := s.tokens().InsertOne(ctx, tokenDoc{Hash: t.Hash, UserID: t.UserID, Kind: t.Kind, ExpiresAt: t.ExpiresAt, CreatedAt: t.CreatedAt})
	return err
}

// ConsumeAuthToken marks an unused, unexpired token used (atomically) and
// returns its user; db.ErrNotFound otherwise.
func (s *store) ConsumeAuthToken(ctx context.Context, hash, kind string, at time.Time) (bson.ObjectID, error) {
	var d tokenDoc
	err := s.tokens().FindOneAndUpdate(ctx,
		bson.M{"_id": hash, "kind": kind, "used_at": bson.M{"$exists": false}, "expires_at": bson.M{"$gt": at}},
		bson.M{"$set": bson.M{"used_at": at}}).Decode(&d)
	if errors.Is(err, mongo.ErrNoDocuments) {
		return bson.ObjectID{}, db.ErrNotFound
	}
	return d.UserID, err
}
