package auth

import (
	"context"
	"time"

	"go.mongodb.org/mongo-driver/v2/bson"
	"go.mongodb.org/mongo-driver/v2/mongo"
	"go.mongodb.org/mongo-driver/v2/mongo/options"
	semiiauth "{{.Semii}}/auth"
	"{{.Semii}}/db/mongodb"
)

func (s *store) apiKeys() *mongo.Collection { return s.db.Collection("api_keys") }

// APIKeyIndexes are the api_keys collection's indexes.
func APIKeyIndexes() []mongo.IndexModel {
	return []mongo.IndexModel{
		{Keys: bson.D{ {Key: "prefix", Value: 1} }, Options: options.Index().SetUnique(true)},
		{Keys: bson.D{ {Key: "user_id", Value: 1} }},
	}
}

type apiKeyDoc struct {
	ID         bson.ObjectID `bson:"_id"`
	UserID     bson.ObjectID `bson:"user_id"`
	Name       string        `bson:"name"`
	Prefix     string        `bson:"prefix"`
	SecretHash string        `bson:"secret_hash"`
	Scopes     []string      `bson:"scopes"`
	ExpiresAt  *time.Time    `bson:"expires_at,omitempty"`
	LastUsedAt *time.Time    `bson:"last_used_at,omitempty"`
	RevokedAt  *time.Time    `bson:"revoked_at,omitempty"`
	CreatedAt  time.Time     `bson:"created_at"`
}

func (d apiKeyDoc) view() APIKey {
	scopes := d.Scopes
	if scopes == nil {
		scopes = []string{}
	}
	return APIKey{ID: d.ID, Name: d.Name, Prefix: d.Prefix, Scopes: scopes,
		ExpiresAt: d.ExpiresAt, LastUsedAt: d.LastUsedAt, CreatedAt: d.CreatedAt.UTC()}
}

func (s *store) CreateAPIKey(ctx context.Context, r apiKeyRow) (APIKey, error) {
	d := apiKeyDoc{ID: bson.NewObjectID(), UserID: r.UserID, Name: r.Name, Prefix: r.Prefix, SecretHash: r.SecretHash,
		Scopes: r.Scopes, ExpiresAt: r.ExpiresAt, CreatedAt: r.CreatedAt}
	if _, err := s.apiKeys().InsertOne(ctx, d); err != nil {
		return APIKey{}, mongodb.MapError(err)
	}
	return d.view(), nil
}

// FindAPIKey implements semiiauth.APIKeyStore.
func (s *store) FindAPIKey(ctx context.Context, prefix string) (semiiauth.APIKey, error) {
	var d apiKeyDoc
	if err := s.apiKeys().FindOne(ctx, bson.M{"prefix": prefix}).Decode(&d); err != nil {
		return semiiauth.APIKey{}, mongodb.MapError(err)
	}
	return semiiauth.APIKey{
		ID: d.ID.Hex(), OwnerID: IDString(d.UserID), Scopes: d.Scopes, SecretHash: d.SecretHash,
		ExpiresAt: d.ExpiresAt, RevokedAt: d.RevokedAt, LastUsedAt: d.LastUsedAt,
	}, nil
}

// TouchAPIKey implements semiiauth.APIKeyStore.
func (s *store) TouchAPIKey(ctx context.Context, id string, at time.Time) error {
	keyID, err := bson.ObjectIDFromHex(id)
	if err != nil {
		return err
	}
	_, err = s.apiKeys().UpdateOne(ctx, bson.M{"_id": keyID}, bson.M{"$set": bson.M{"last_used_at": at}})
	return err
}

func (s *store) ListAPIKeys(ctx context.Context, owner bson.ObjectID) ([]APIKey, error) {
	cur, err := s.apiKeys().Find(ctx, bson.M{"user_id": owner, "revoked_at": bson.M{"$exists": false}},
		options.Find().SetSort(bson.D{ {Key: "created_at", Value: -1} }))
	if err != nil {
		return nil, err
	}
	var docs []apiKeyDoc
	if err := cur.All(ctx, &docs); err != nil {
		return nil, err
	}
	keys := make([]APIKey, len(docs))
	for i, d := range docs {
		keys[i] = d.view()
	}
	return keys, nil
}

// RevokeAPIKey revokes id if owner owns it, returning how many keys changed.
func (s *store) RevokeAPIKey(ctx context.Context, id, owner bson.ObjectID, at time.Time) (int64, error) {
	res, err := s.apiKeys().UpdateOne(ctx,
		bson.M{"_id": id, "user_id": owner, "revoked_at": bson.M{"$exists": false}},
		bson.M{"$set": bson.M{"revoked_at": at}})
	if err != nil {
		return 0, err
	}
	return res.ModifiedCount, nil
}

// expireAPIKey sets a key's expiry (tests).
func (s *store) expireAPIKey(ctx context.Context, prefix string, at time.Time) error {
	_, err := s.apiKeys().UpdateOne(ctx, bson.M{"prefix": prefix}, bson.M{"$set": bson.M{"expires_at": at}})
	return err
}
