# Local services. Database only (for `semii dev`): docker compose up -d db
# Whole stack in containers:                       docker compose up --build
services:
  app:
    build: .
    env_file: .env
    environment:
{{- if .Postgres}}
      DATABASE_URL: postgres://postgres:postgres@db:5432/{{.DBName}}?sslmode=disable
{{- else if .MySQL}}
      DATABASE_URL: mysql://app:app@db:3306/{{.DBName}}
{{- else if .SQLite}}
      DATABASE_URL: /data/{{.DBName}}.db
{{- else}}
      DATABASE_URL: mongodb://db:27017/?directConnection=true
{{- end}}
      HTTP_ADDR: ":8080"
      DB_AUTO_MIGRATE: "true"
    ports:
      - "8080:8080"
{{- if .SQLite}}
    volumes:
      - dbdata:/data
{{- else}}
    depends_on:
      db:
        condition: service_healthy
{{- end}}
{{- if not .SQLite}}

  db:
{{- end}}
{{- if .Postgres}}
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: {{.DBName}}
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d {{.DBName}}"]
      interval: 2s
      timeout: 5s
      retries: 15
    volumes:
      - dbdata:/var/lib/postgresql/data
{{- else if .MySQL}}
    image: mysql:8.4
    environment:
      MYSQL_ROOT_PASSWORD: root
      MYSQL_DATABASE: {{.DBName}}
      MYSQL_USER: app
      MYSQL_PASSWORD: app
    ports:
      - "3306:3306"
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1", "-proot"]
      interval: 2s
      timeout: 5s
      retries: 30
    volumes:
      - dbdata:/var/lib/mysql
{{- else if .Mongo}}
    # A single-node replica set: MongoDB transactions require one.
    image: mongo:7
    command: ["mongod", "--replSet", "rs0", "--bind_ip_all"]
    ports:
      - "27017:27017"
    healthcheck:
      test: ["CMD", "mongosh", "--quiet", "--eval", "try { rs.status().ok } catch (e) { rs.initiate({_id: 'rs0', members: [{_id: 0, host: 'localhost:27017'}]}).ok }"]
      interval: 2s
      timeout: 5s
      retries: 30
    volumes:
      - dbdata:/data/db
{{- end}}

volumes:
  dbdata:
