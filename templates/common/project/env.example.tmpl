# Copy to .env for local development: cp .env.example .env
# Variables set in the real environment win over this file.
SEMII_ENV=development
LOG_LEVEL=debug

{{if .Postgres -}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{.DBName}}?sslmode=disable
{{- else if .MySQL}}
DATABASE_URL=mysql://app:app@localhost:3306/{{.DBName}}
{{- else if .SQLite}}
DATABASE_URL={{.DBName}}.db
{{- else}}
DATABASE_URL=mongodb://localhost:27017/?directConnection=true
DB_NAME={{.DBName}}
{{- end}}
# DB_MAX_CONNS=8
# Apply {{if .Mongo}}indexes{{else}}migrations{{end}} on boot (refused in production unless DB_AUTO_MIGRATE_PRODUCTION=true).
DB_AUTO_MIGRATE=false

HTTP_ADDR=:8080
# HTTP_MAX_BODY_BYTES=1048576
# HTTP_HANDLER_TIMEOUT=30s
# Comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For.
# HTTP_TRUSTED_PROXIES=127.0.0.1/32
# HTTP_CORS_ALLOWED_ORIGINS=http://localhost:3000

{{- if .SQLite}}
# Integration tests use a fresh SQLite file per test in a temporary directory.
{{- else}}
# Integration tests start a database container automatically (Docker).
# To use a running server instead, set TEST_DATABASE_URL; each test gets
# its own database on it.
{{- if .Postgres}}
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
{{- else if .MySQL}}
# TEST_DATABASE_URL=mysql://root:root@localhost:3306/mysql
{{- else}}
# TEST_DATABASE_URL=mongodb://localhost:27017/?directConnection=true
{{- end}}
{{- end}}
