# syntax=docker/dockerfile:1
# Build: docker build --build-arg VERSION=$(git describe --always) -t {{.Name}} .
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY . .
ARG VERSION=dev
# Module and build caches survive between builds; vendor/ is used if present.
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath \
      -ldflags "-s -w -X {{.Semii}}/server.Version=${VERSION}" \
      -o /out/api ./cmd/api
{{- if .SQLite}}
# The database lives on a volume at /data, owned by the nonroot user.
RUN mkdir -p /out/data
{{- end}}

# No shell, no package manager, not root. Migrations are embedded in the
# binary: run them with `api migrate`.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/api /api
{{- if .SQLite}}
COPY --from=build --chown=nonroot:nonroot /out/data /data
ENV DATABASE_URL=/data/{{.DBName}}.db
VOLUME /data
{{- end}}
ENV SEMII_ENV=production HTTP_ADDR=:8080
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/api"]
