// Command api serves the {{.Name}} HTTP API.
//
//	api           run the server
//	api migrate   apply pending {{if .Mongo}}index changes{{else}}migrations{{end}} and exit
package main

import (
	"context"
	"fmt"
	"io"
	"os"

	"{{.Module}}/internal/app"
	"{{.Module}}/internal/config"
	"{{.Semii}}/banner"
	"{{.Semii}}/logx"
	"{{.Semii}}/server"
)

func main() {
	if err := run(); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

func run() error {
	cfg, err := config.Load()
	if err != nil {
		return err
	}
	log := logx.New(cfg.Env, cfg.LogLevel)
	ctx := context.Background()
	if len(os.Args) > 1 {
		if os.Args[1] != "migrate" {
			return fmt.Errorf("unknown command %q (usage: api [migrate])", os.Args[1])
		}
		return app.Migrate(ctx, cfg, log)
	}
	if cfg.Env == "development" {
		// The semii leaf, only in an interactive terminal (never in logs).
		banner.Print(os.Stderr, {{printf "%q" (print .Name " · development")}}, "built with semii")
	}
	a, err := app.New(ctx, cfg, log)
	if err != nil {
		return err
	}
	return server.Run(ctx, server.Config{
		Addr:    cfg.HTTP.Addr,
		Handler: a.Handler,
		Logger:  log,
		Health:  server.Health{Checks: map[string]server.Check{"db": a.Ping}},
		Closers: []io.Closer{a},
		DrainDelay: cfg.HTTP.DrainDelay,
	})
}
