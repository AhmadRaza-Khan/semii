package auth

import (
	"errors"
	"net/http"
	"strconv"
	"time"

	"github.com/google/uuid"
	"go.mongodb.org/mongo-driver/v2/bson"
	semiiauth "{{.Semii}}/auth"
	"{{.Semii}}/web"
)

// User is an account as returned by the API.
type User struct {
	ID            {{.IDGo}}     `json:"id"`
	Email         string        `json:"email"`
	Roles         []string      `json:"roles"`
	EmailVerified bool          `json:"email_verified"`
	CreatedAt     time.Time     `json:"created_at"`

	passwordHash string
	failedLogins int32
	lockedUntil  *time.Time
}

// Rows exchanged with the store.
type (
	newUser struct {
		Email, PasswordHash string
		CreatedAt           time.Time
	}
	authToken struct {
		Hash      string
		UserID    {{.IDGo}}
		Kind      string // "reset" | "verify"
		ExpiresAt time.Time
		CreatedAt time.Time
	}
	sessionRow struct {
		IDHash                          string
		UserID                          {{.IDGo}}
		CreatedAt, LastSeenAt, ExpiresAt time.Time
		UserAgent, IP                   string
	}
	refreshRow struct {
		Hash                 string
		FamilyID             uuid.UUID
		UserID               {{.IDGo}}
		ExpiresAt, CreatedAt time.Time
		UsedAt, RevokedAt    *time.Time
	}
	apiKeyRow struct {
		UserID     {{.IDGo}}
		Name       string
		Prefix     string
		SecretHash string
		Scopes     []string
		ExpiresAt  *time.Time
		CreatedAt  time.Time
	}
)

{{- if .SeqID}}

// IDString formats a user id for Principal.ID.
func IDString(id int64) string { return strconv.FormatInt(id, 10) }

func parseID(s string) (int64, error) { return strconv.ParseInt(s, 10, 64) }
{{- else if .ObjectID}}

// IDString formats a user id for Principal.ID.
func IDString(id bson.ObjectID) string { return id.Hex() }

func parseID(s string) (bson.ObjectID, error) { return bson.ObjectIDFromHex(s) }
{{- else}}

func newID() uuid.UUID { return uuid.Must(uuid.NewV7()) }

// IDString formats a user id for Principal.ID.
func IDString(id uuid.UUID) string { return id.String() }

func parseID(s string) (uuid.UUID, error) { return uuid.Parse(s) }
{{- end}}

// userID returns the id of the user behind the request's principal.
func userID(r *http.Request) ({{.IDGo}}, error) {
	p, ok := semiiauth.FromContext(r.Context())
	if !ok {
		var zero {{.IDGo}}
		return zero, semiiauth.Unauthenticated()
	}
	id, err := parseID(p.ID)
	if err != nil {
		return id, semiiauth.Unauthenticated()
	}
	return id, nil
}

// now is the timestamp source: UTC at microsecond precision.
func now() time.Time { return time.Now().UTC().Truncate(time.Microsecond) }

// Errors shown to clients.
var (
	errNoLogin      = errors.New("strategy does not sign users in")
	errInvalidToken = web.NewError(http.StatusBadRequest, "invalid_token", "the link is invalid, expired or already used")
	errUnverified   = web.NewError(http.StatusForbidden, "email_unverified", "verify your email address before signing in")
	errStrategyOff  = web.NewError(http.StatusNotFound, "not_found", "this sign-in method is not enabled")
)
