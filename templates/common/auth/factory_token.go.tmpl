package factory

import (
	"testing"

	"{{.Module}}/internal/app"
	"{{.Module}}/internal/auth"
	semiiauth "{{.Semii}}/auth"
)

// Token returns a valid access token for u, signed with the app's key.
func Token(t testing.TB, a *app.App, u auth.User) string {
	t.Helper()
	j, err := semiiauth.NewJWT(a.Config.Auth)
	if err != nil {
		t.Fatal(err)
	}
	tok, _, err := j.Issue(auth.IDString(u.ID), u.Roles)
	if err != nil {
		t.Fatal(err)
	}
	return tok
}
