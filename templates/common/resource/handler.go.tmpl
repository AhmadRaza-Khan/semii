package {{.Pkg}}

import (
	"fmt"
	"net/http"

	"{{.Semii}}/web"
)

// Handler serves the {{.Route}} endpoints.
type Handler struct {
	svc *Service
}

// NewHandler returns a Handler using svc.
func NewHandler(svc *Service) *Handler { return &Handler{svc: svc} }

// List handles GET {{.Route}}: newest first, cursor-paginated
// (?limit=&cursor=){{if .Filters}}, filterable by{{range $i, $f := .Filters}}{{if $i}},{{end}} {{$f.Col}}{{end}}{{end}}.
func (h *Handler) List(w http.ResponseWriter, r *http.Request) error {
	f, err := web.DecodeQuery[ListFilter](r)
	if err != nil {
		return err
	}
	p, err := web.ParseCursor(r, 20, 100)
	if err != nil {
		return err
	}
	items, next, err := h.svc.List(r.Context(), f, p)
	if err != nil {
		return err
	}
	if items == nil {
		items = []{{.Name}}{}
	}
	return web.JSON(w, http.StatusOK, web.CursorPage[{{.Name}}]{Data: items, NextCursor: next})
}

// Create handles POST {{.Route}}.
func (h *Handler) Create(w http.ResponseWriter, r *http.Request) error {
	in, err := web.Decode[CreateInput](r)
	if err != nil {
		return err
	}
	out, err := h.svc.Create(r.Context(), in)
	if err != nil {
		return err
	}
	return web.Created(w, "{{.Route}}/"+IDString(out.ID), out)
}

// Get handles GET {{.Route}}/{id}.
func (h *Handler) Get(w http.ResponseWriter, r *http.Request) error {
	id, err := pathID(r)
	if err != nil {
		return err
	}
	out, err := h.svc.Get(r.Context(), id)
	if err != nil {
		return err
	}
	return web.JSON(w, http.StatusOK, out)
}

// Update handles PATCH {{.Route}}/{id}.
func (h *Handler) Update(w http.ResponseWriter, r *http.Request) error {
	id, err := pathID(r)
	if err != nil {
		return err
	}
	in, err := web.Decode[UpdateInput](r)
	if err != nil {
		return err
	}
	out, err := h.svc.Update(r.Context(), id, in)
	if err != nil {
		return err
	}
	return web.JSON(w, http.StatusOK, out)
}

// Delete handles DELETE {{.Route}}/{id}.
func (h *Handler) Delete(w http.ResponseWriter, r *http.Request) error {
	id, err := pathID(r)
	if err != nil {
		return err
	}
	if err := h.svc.Delete(r.Context(), id); err != nil {
		return err
	}
	return web.NoContent(w)
}
