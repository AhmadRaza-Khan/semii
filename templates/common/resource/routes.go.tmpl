package {{.Pkg}}

import (
	semiiauth "{{.Semii}}/auth"
	"{{.Semii}}/web"
)

// Register mounts the {{.PluralVar}} endpoints under {{.Route}}.
func Register(r *web.Router, h *Handler) {
{{- if .Public}}
	// Public: anyone can call these endpoints. Replace Public() with
	// Require(...) once authentication is set up.
	g := r.Group("{{.Route}}").Public()
{{- else}}
	// Authenticated: every signed-in user can reach every {{.Var}} by id.
	// For per-user data, scope the repository by auth.FromContext; see
	// docs/packages/auth.md#per-user-data.
	g := r.Group("{{.Route}}").Require(semiiauth.Authenticated())
{{- end}}
	g.HandleFunc("GET /", h.List)
	g.HandleFunc("POST /", h.Create)
	g.HandleFunc("GET /{id}", h.Get)
	g.HandleFunc("PATCH /{id}", h.Update)
	g.HandleFunc("DELETE /{id}", h.Delete)
}
