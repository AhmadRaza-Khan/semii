# Copy to .env for local development: cp .env.example .env
# Variables set in the real environment win over this file.
SEMII_ENV=development
LOG_LEVEL=debug

DATABASE_URL=postgres://postgres:postgres@localhost:5432/shop_postgres?sslmode=disable
# DB_MAX_CONNS=8
# Apply migrations on boot (refused in production unless DB_AUTO_MIGRATE_PRODUCTION=true).
DB_AUTO_MIGRATE=false

HTTP_ADDR=:8080
# HTTP_MAX_BODY_BYTES=1048576
# HTTP_HANDLER_TIMEOUT=30s
# Comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For.
# HTTP_TRUSTED_PROXIES=127.0.0.1/32
# HTTP_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Integration tests start a database container automatically (Docker).
# To use a running server instead, set TEST_DATABASE_URL; each test gets
# its own database on it.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

# Auth (see semii/auth.Config). Strategies: session, jwt, apikey.
AUTH_STRATEGIES=jwt,apikey
AUTH_APP_URL=http://localhost:3000
# HS256 signing key, at least 32 bytes. Use a unique random value per environment.
AUTH_JWT_SECRET=dev-only-secret-change-me-in-production
# AUTH_REQUIRE_VERIFIED_EMAIL=false

# Account emails. While SMTP_HOST is empty, links are logged (development
# only); production refuses to start without it.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com

# semii db seed creates this admin account when set.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
